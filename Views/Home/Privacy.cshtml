@{
    ViewData["Title"] = "Contact us";
}
<h1>Kontakta oss</h1>

<p>Kontakta om du har frågor våra filmer eller vill tipsa oss om nya filmer</p>

<form asp-action="ContactUs">
    <label for="nameInput">Namn <span style="color: red;">*</span></label>
    <input type="text" name="nameInput" placeholder="Ange ditt namn" required/>
    
    <label for="emailInput">Epostadress <span style="color: red;">*</span></label>
    <input type="Email" name="emailInput" placeholder="Ange din epostadress" required />

    <label for="phoneNbrInput">Mobilnr:</label>
    <input type="text" name="phoneNbrInput" placeholder="Ange ditt mobilnr" />

    <label for="messageInput">Meddelande:</label>
    <textarea name="messageInput" placeholder="Skriv ditt meddelande" />
    
    <button class="button" type="submit">Skicka</button>
</form>
