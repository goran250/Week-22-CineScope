@model CineScope.Models.Actor

@{
    ViewData["Title"] = "Actor details";
}
<div class="homePage">
    <h2 class="pageHeading">Detaljer</h2>
    <hr />
    <div class="actorDetails">      
       <img src="~/images/@Model.PictureFilename" alt="Bild" class="actorDetailsImg" />
        <br />
        <div class="actorDetailsText">
            <dl class="row">
                <dt class = "col-sm-2">Namn</dt>
                <dd class = "col-sm-10">
                    @Html.DisplayFor(model => model.Name)
                </dd>
            </dl>
            <dl class="row">
                <dt class = "col-sm-2">Land</dt>
                <dd class = "col-sm-10">
                    @Html.DisplayFor(model => model.Country)
                </dd>
            </dl>
            <dl class="row">
                <dt class = "col-sm-2">Filmer</dt>
                <dd class = "col-sm-10">
                    @foreach (Movie movie in Model.Movies)
                    {
                        <p style="margin-right: 5px;">@movie.ReleaseDate.Year - @movie.Title</p>
                    }
                </dd>
            </dl>
            <div>
                <a asp-action="AllActors"><button class="button green">Tillbaka till skådespelarlistan</button></a>
            </div>
        </div>
    </div>
    
</div>
