@model CineScope.Models.Actor

@{
    ViewData["Title"] = "DeleteActor";
}

<div class="adminPage">
    <a asp-action="Index" style="text-decoration: none"><h1 class="pageHeading blueText">Admin</h1></a>
    <h2 class="pageHeading">Ta bort</h2>
    <h5 class="subPageHeading">Är du säker på att du vill ta bort denna skådespelaren?</h5>

    <div>
        <hr />
        <dl class="row">
            <dt class = "col-sm-2">Namn</dt>
            <dd class = "col-sm-10">
                @Html.DisplayFor(model => model.Name)
            </dd>
        </dl>
        <dl class="row">
            <dt class = "col-sm-2">Land</dt>
            <dd class = "col-sm-10">
                @Html.DisplayFor(model => model.Country)
            </dd>
        </dl>
    
        <form asp-action="DeleteActor">
            <input type="hidden" asp-for="Id" />
            <input type="submit" value="Ta bort" class="btn btn-danger" /> 
            <br/><br/>
            <a asp-action="AllActors">Tillbaka till skådespelarlistan</a>
        </form>
    </div>
</div>