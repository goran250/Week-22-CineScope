@model IEnumerable<CineScope.Models.Actor>

@{
    ViewData["Title"] = "AllActors";
}

<div class="adminPage">
    <a asp-action="Index" style="text-decoration: none"><h1 class="pageHeading blueText">Admin</h1></a>
    <h2 class="subPageHeading">Alla skådespelare</h2>

    <p>
        <a asp-action="CreateActor">Lägg till en ny skådespelare</a>
    </p>

    <table class="table actorsTable">
        <thead>
            <tr>
                <th></th>
                <th>Namn</th>
                <th>Land</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model) {
                <tr>
                    <td class="firstColumn"><img src="~/images/@item.PictureFilename" alt="Poster" width="60" /></td>
                    <td style="padding-top: 25px;">
                        @Html.DisplayFor(model => item.Name)
                    </td>
                    <td style="padding-top: 25px;">
                        @Html.DisplayFor(model => item.Country)
                    </td>
                    <td class="paddingTop">
                        <a asp-action="EditActor" asp-route-id="@item.Id"><button class="button">Ändra</button></a>
                        <a asp-action="ActorDetails" asp-route-id="@item.Id"><button class="button">Detaljer</button></a>
                        <a asp-action="DeleteActor" asp-route-id="@item.Id"><button class="button remove">Ta bort</button></a>
                    </td>
                </tr>
        }
        </tbody>
    </table>
</div>
