@model CineScope.Models.Actor

@{
    ViewData["Title"] = "Actor details";
}
<div class="adminPage">
    <a asp-action="Index" style="text-decoration: none"><h1 class="pageHeading blueText">Admin</h1></a>
    <h2 class="subPageHeading">Detaljer</h2>
    <hr />
    <div class="actorDetails">        
        <div><img src="~/images/@Model.PictureFilename" alt="Bild" width="300px" /></div>
        <br />
        <dl class="row">
            <dt class = "col-sm-2">Namn</dt>
            <dd class = "col-sm-10">
                @Html.DisplayFor(model => model.Name)
            </dd>
        </dl>
        <dl class="row">
            <dt class = "col-sm-2">Land</dt>
            <dd class = "col-sm-10">
                @Html.DisplayFor(model => model.Country)
            </dd>
        </dl>
        <dl class="row">
            <dt class = "col-sm-2">Filmer</dt>
            <dd class = "col-sm-10">
                 @foreach (Movie movie in Model.Movies)
                {
                    <p style="margin-right: 5px;">@movie.ReleaseDate.Year - @movie.Title</p>
                }
            </dd>
        </dl>
        <div>
            <a asp-action="EditActor" asp-route-id="@Model?.Id"><button class="button">Ändra</button></a>
            <a asp-action="AllActors"><button class="button green">Tillbaka till skådespelarlistan</button></a>
        </div>
    </div>  
</div>
